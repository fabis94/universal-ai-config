    "duplicateRunChecks": [
      {
        "against": "claude",
        "events": [
          "preToolUse",
          "postToolUse",
          "userPromptSubmit",
          "stop",
          "subagentStop",
          "sessionStart",
          "sessionEnd",
          "preCompact",
        ],
        "onlyWithMatcher": true,
        "target": "cursor",
      },
    ],
    "servedBy": [
      {
        "by": "agentsMd",
        "loses": "file-pattern scoping (\`paths\` globs); nested AGENTS.md files load only when Claude reads a file in that folder, and none load while a non-empty CLAUDE.md, .claude/CLAUDE.md or CLAUDE.local.md exists",
        "reconcile": "loads-both",
        "target": "claude",
        "type": "instructions",
      },
      {
        "by": "agentsMd",
        "loses": "\`applyTo\` patterns, \`excludeAgent\` and \`name\`; nested AGENTS.md files load only after Copilot views a file in that folder (CLI 1.0 and later)",
        "reconcile": "loads-both",
        "target": "copilot",
        "type": "instructions",
      },
      {
        "by": "claude",
        "loses": "Copilot-only events (userPromptTransformed, preMcpToolCall, postResult, prePRDescription), \`cwd\`/\`env\`, and hooks in the GitHub cloud agent, which reads only .github/hooks. Copilot runs Claude-format hooks with Claude's tool names and payloads, and exit code 1 blocks the tool",
        "reconcile": "loads-both",
        "rejectsHandlerTypes": [
          "prompt",
          "agent",
          "mcp_tool",
        ],
        "target": "copilot",
        "type": "hooks",
      },
      {
        "by": "claude",
        "loses": "Copilot-specific server values (per-target \`copilot\` overrides) and Copilot-only fields such as \`deferTools\`: the shared .mcp.json is rendered for Claude",
        "reconcile": "same-file",
        "target": "copilot",
        "type": "mcp",
      },
      {
        "by": "agentsMd",
        "loses": "glob-scoped and description-only (agent-decided) rules: they become always-on or folder-scoped",
        "reconcile": "loads-both",
        "target": "cursor",
        "type": "instructions",
      },
    ],
  },
}
`;

